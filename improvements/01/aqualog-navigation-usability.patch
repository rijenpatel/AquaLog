+  // Glanceable farm-level KPI strip shown directly under the context
+  // switcher. Four compact tiles: active batches, today's feed load,
+  // pending sampling obligations, and total stocked biomass headcount.
+  Widget _buildFarmPulseStrip(
+    ThemeData theme,
+    AppSettingsState settings, {
+    required List<Batch> activeBatches,
+    required List<FeedRecord> feedRecords,
+    required List<SamplingEntry> samplings,
+  }) {
+    final now = DateTime.now();
+    final today = DateTime(now.year, now.month, now.day);
+
+    final todayKg = feedRecords
+        .where((r) => DateTime(r.date.year, r.date.month, r.date.day) == today)
+        .fold<double>(
+          0.0,
+          (sum, r) => sum + FeedCalculator.getRecordTotalKg(r),
+        );
+
+    var samplingDue = 0;
+    for (final b in activeBatches) {
+      final batchSamples = samplings.where((s) => s.batchId == b.id).toList();
+      final latest = batchSamples.isNotEmpty ? batchSamples.first : null;
+      final status = SamplingCalculator.getSamplingStatus(
+        batchStatus: b.status,
+        stockingDate: b.stockingDate,
+        latestSamplingDate: latest?.date,
+        today: now,
+      );
+      if (status.isDue) samplingDue++;
+    }
+
+    final stockedPcs = activeBatches.fold<int>(
+      0,
+      (sum, b) => sum + b.shrimpStockedCount,
+    );
+    String pcsLabel;
+    if (stockedPcs >= 100000) {
+      pcsLabel = '${(stockedPcs / 100000).toStringAsFixed(1)}L pcs';
+    } else if (stockedPcs >= 1000) {
+      pcsLabel = '${(stockedPcs / 1000).toStringAsFixed(0)}k pcs';
+    } else {
+      pcsLabel = '$stockedPcs pcs';
+    }
+
+    final todayFeedLabel = todayKg >= 1.0
+        ? '${todayKg.toStringAsFixed(1)} kg'
+        : '${(todayKg * 1000.0).toStringAsFixed(0)} g';
+
+    final isDark = theme.brightness == Brightness.dark;
+
+    Widget tile({
+      required IconData icon,
+      required String value,
+      required String label,
+      Color? accent,
+    }) {
+      final effectiveAccent = accent ?? theme.colorScheme.primary;
+      return Expanded(
+        child: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
+          decoration: BoxDecoration(
+            color:
+                theme.cardTheme.color ?? theme.colorScheme.surfaceContainerLow,
+            borderRadius: BorderRadius.circular(14),
+            border: Border.all(
+              color: isDark ? const Color(0x1FFFFFFF) : const Color(0x14000000),
+            ),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Row(
+                children: [
+                  Icon(icon, size: 13, color: effectiveAccent),
+                  const Spacer(),
+                  if (accent != null)
+                    Container(
+                      width: 5,
+                      height: 5,
+                      decoration: BoxDecoration(
+                        color: effectiveAccent,
+                        shape: BoxShape.circle,
+                        boxShadow: [
+                          BoxShadow(
+                            color: effectiveAccent.withOpacity(0.5),
+                            blurRadius: 3,
+                          ),
+                        ],
+                      ),
+                    ),
+                ],
+              ),
+              const SizedBox(height: 6),
+              Text(
+                value,
+                style: theme.textTheme.titleMedium?.copyWith(
+                  fontWeight: FontWeight.w700,
+                  letterSpacing: -0.3,
+                  color: theme.colorScheme.onSurface,
+                  fontFeatures: const [FontFeature.tabularFigures()],
+                ),
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+              ),
+              const SizedBox(height: 2),
+              Text(
+                label,
+                style: theme.textTheme.labelSmall?.copyWith(
+                  fontSize: 9.5,
+                  color: theme.colorScheme.onSurfaceVariant,
+                  fontWeight: FontWeight.w600,
+                ),
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+              ),
+            ],
+          ),
+        ),
+      );
+    }
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        Row(
+          children: [
+            Icon(
+              Icons.monitor_heart_rounded,
+              size: 13,
+              color: theme.colorScheme.primary,
+            ),
+            const SizedBox(width: 5),
+            Text(
+              settings.tr('farm_pulse'),
+              style: theme.textTheme.labelSmall?.copyWith(
+                fontWeight: FontWeight.w700,
+                letterSpacing: 0.3,
+                color: theme.colorScheme.onSurfaceVariant,
+              ),
+            ),
+          ],
+        ),
+        const SizedBox(height: 6),
+        Row(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            tile(
+              icon: Icons.layers_rounded,
+              value: '${activeBatches.length}',
+              label: settings.tr('kpi_active_batches'),
+            ),
+            const SizedBox(width: 8),
+            tile(
+              icon: Icons.restaurant_rounded,
+              value: todayFeedLabel,
+              label: settings.tr('kpi_today_feed'),
+            ),
+            const SizedBox(width: 8),
+            tile(
+              icon: Icons.scale_rounded,
+              value: '$samplingDue',
+              label: settings.tr('kpi_sampling_due'),
+              accent: samplingDue > 0
+                  ? theme.colorScheme.error
+                  : AquaColors.statusOptimal,
+            ),
+            const SizedBox(width: 8),
+            tile(
+              icon: Icons.set_meal_rounded,
+              value: pcsLabel,
+              label: settings.tr('kpi_stocked'),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
