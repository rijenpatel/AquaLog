diff --git a/aqualog/test/navigation_usability_test.dart b/aqualog/test/navigation_usability_test.dart
new file mode 100644
index 0000000..7e3a8e1
--- /dev/null
+++ b/aqualog/test/navigation_usability_test.dart
@@ -0,0 +1,123 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:drift/native.dart';
+import 'package:aqualog/app/app.dart';
+import 'package:aqualog/core/database/app_database.dart';
+import 'package:aqualog/core/providers/database_provider.dart';
+import 'package:aqualog/core/providers/settings_provider.dart';
+import 'package:aqualog/core/services/demo_data_service.dart';
+
+/// Regression coverage for the navigation & KPI usability overhaul:
+/// - 5 primary destinations (feed logging moved to Quick Actions FAB,
+///   settings moved to the app bar gear)
+/// - Quick Actions sheet exposes the four field tasks from any screen
+/// - Settings opens as a pushed route
+/// - Tab switching still works end-to-end
+void main() {
+  Future<AppDatabase> pumpApp(WidgetTester tester) async {
+    // Phone-class surface so the compact bottom-navigation layout is used.
+    tester.view.physicalSize = const Size(390, 844);
+    tester.view.devicePixelRatio = 1.0;
+    addTearDown(tester.view.reset);
+
+    SharedPreferences.setMockInitialValues({});
+    final prefs = await SharedPreferences.getInstance();
+    final db = AppDatabase(NativeDatabase.memory());
+    await db.saveUserProfile('Farmer John');
+    await DemoDataService(db).loadDemoData();
+
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          sharedPreferencesProvider.overrideWithValue(prefs),
+          appDatabaseProvider.overrideWithValue(db),
+        ],
+        child: const AquaLogApp(),
+      ),
+    );
+    await tester.pumpAndSettle();
+    return db;
+  }
+
+  testWidgets('Bottom navigation exposes exactly 5 destinations', (
+    WidgetTester tester,
+  ) async {
+    final db = await pumpApp(tester);
+
+    expect(find.byType(NavigationBar), findsOneWidget);
+    expect(find.byType(NavigationDestination), findsNWidgets(5));
+    expect(find.text('Overview'), findsWidgets);
+    expect(find.text('Manage'), findsWidgets);
+    expect(find.text('Stock'), findsWidgets);
+    expect(find.text('Finance'), findsWidgets);
+    expect(find.text('Reports'), findsWidgets);
+    // Feed logging is a task, not a tab: no 7th destination labels.
+    expect(find.text('Log Feed'), findsNothing);
+
+    await db.close();
+  });
+
+  testWidgets('Quick Actions FAB opens sheet with four field tasks', (
+    WidgetTester tester,
+  ) async {
+    final db = await pumpApp(tester);
+
+    // Demo farm has active batches → FAB present on compact layout.
+    expect(find.byType(FloatingActionButton), findsOneWidget);
+    await tester.tap(find.byType(FloatingActionButton));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Quick Actions'), findsOneWidget);
+    expect(find.text('Log Feed Session'), findsOneWidget);
+    expect(find.text('Log Water Test'), findsOneWidget);
+    expect(find.text('Add Sampling'), findsOneWidget);
+    expect(find.text('Log Mortality'), findsOneWidget);
+
+    // Water test opens the pond-scoped entry page.
+    await tester.tap(find.text('Log Water Test'));
+    await tester.pumpAndSettle();
+    expect(find.text('Log Water Quality'), findsOneWidget);
+
+    await db.close();
+  });
+
+  testWidgets('App bar gear opens Settings as pushed route', (
+    WidgetTester tester,
+  ) async {
+    final db = await pumpApp(tester);
+
+    await tester.tap(find.byIcon(Icons.settings_outlined).first);
+    await tester.pumpAndSettle();
+
+    // Pushed route shows the settings page header.
+    expect(find.text('Settings & Configuration'), findsOneWidget);
+
+    // Back returns to the dashboard shell.
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    expect(find.text('Settings & Configuration'), findsNothing);
+
+    await db.close();
+  });
+
+  testWidgets('Tabs switch and preserve shell (Finance → Overview)', (
+    WidgetTester tester,
+  ) async {
+    final db = await pumpApp(tester);
+
+    // Switch to Finance tab (destination index 3) by widget, not text —
+    // 'Overview' text also appears in the dashboard context switcher.
