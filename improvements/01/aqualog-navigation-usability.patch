diff --git a/aqualog/lib/core/widgets/aqua_quick_actions.dart b/aqualog/lib/core/widgets/aqua_quick_actions.dart
new file mode 100644
index 0000000..8594686
--- /dev/null
+++ b/aqualog/lib/core/widgets/aqua_quick_actions.dart
@@ -0,0 +1,389 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../database/app_database.dart';
+import '../providers/dashboard_context_provider.dart';
+import '../providers/database_provider.dart';
+import '../providers/settings_provider.dart';
+import '../../app/theme/color_schemes.dart';
+import '../../features/feed/feed_logging_page.dart';
+import '../../features/sampling/sampling_dialog.dart';
+import '../../features/water_quality/water_quality_entry_page.dart';
+import '../../features/mortality/mortality_logging_dialog.dart';
+
+/// Resolved context for quick field actions: which pond / batch the
+/// next entry will apply to.
+class _QuickActionContext {
+  final Batch? batch;
+  final Pond? pond;
+
+  const _QuickActionContext({this.batch, this.pond});
+
+  bool get hasBatch => batch != null && pond != null;
+  bool get hasPond => pond != null;
+}
+
+/// Global one-tap field data entry.
+///
+/// The four highest-frequency field tasks (feed session, water test,
+/// cast-net sampling, mortality) are reachable from ANY screen via the
+/// shell FAB — previously each required: open dashboard → tap batch →
+/// scroll a 15-section page to the bottom buttons.
+class AquaQuickActions {
+  static Future<void> show(BuildContext context, WidgetRef ref) async {
+    HapticFeedback.lightImpact();
+
+    final db = ref.read(appDatabaseProvider);
+    final settings = ref.read(appSettingsProvider);
+    final navContext = ref.read(dashboardContextProvider);
+
+    // Resolve target: dashboard-selected batch → latest stocked active
+    // batch → none. Read synchronously before any await.
+    final selectedBatchId = navContext is BatchDashboardContext
+        ? navContext.batchId
+        : null;
+
+    Batch? batch;
+    if (selectedBatchId != null) {
+      final rows = await (db.select(
+        db.batches,
+      )..where((b) => b.id.equals(selectedBatchId))).get();
+      batch = rows.isEmpty ? null : rows.first;
+    }
+    if (batch == null || batch.status != 'active') {
+      final rows =
+          await (db.select(db.batches)
+                ..where((b) => b.status.equals('active'))
+                ..orderBy([(b) => OrderingTerm.desc(b.stockingDate)]))
+              .get();
+      batch = rows.isEmpty ? null : rows.first;
+    }
+
+    Pond? pond;
+    if (batch != null) {
+      final rows = await (db.select(
+        db.ponds,
+      )..where((p) => p.id.equals(batch!.pondId))).get();
+      pond = rows.isEmpty ? null : rows.first;
+    } else {
+      // No active batch — fall back to any active pond so a water test
+      // is still loggable (pond conditioning before stocking).
+      final rows =
+          await (db.select(db.ponds)
+                ..where((p) => p.status.equals('active'))
+                ..orderBy([(p) => OrderingTerm.asc(p.name)]))
+              .get();
+      pond = rows.isEmpty ? null : rows.first;
+    }
+
+    final actionCtx = _QuickActionContext(batch: batch, pond: pond);
+
+    if (!context.mounted) return;
+
+    await showModalBottomSheet<void>(
+      context: context,
+      isScrollControlled: true,
+      backgroundColor: Colors.transparent,
+      builder: (sheetContext) {
+        final theme = Theme.of(sheetContext);
+        return _QuickActionsSheet(
+          theme: theme,
+          settings: settings,
+          actionCtx: actionCtx,
+          onAction: (action) {
+            Navigator.of(sheetContext).pop();
+            _invoke(sheetContext, ref, actionCtx, action);
+          },
+        );
+      },
+    );
+  }
+
+  static void _invoke(
+    BuildContext context,
+    WidgetRef ref,
+    _QuickActionContext ctx,
+    _QuickAction action,
+  ) {
+    switch (action) {
+      case _QuickAction.logFeed:
+        if (!ctx.hasBatch) return;
+        Navigator.of(context).push(
+          MaterialPageRoute(
+            builder: (_) => FeedLoggingPage(initialPondId: ctx.pond!.id),
+          ),
+        );
+        break;
+      case _QuickAction.waterTest:
+        if (!ctx.hasPond) return;
+        WaterQualityEntryPage.show(context, pondId: ctx.pond!.id);
+        break;
+      case _QuickAction.sampling:
+        if (!ctx.hasBatch) return;
+        SamplingDialog.show(context, batch: ctx.batch!, pond: ctx.pond!);
+        break;
+      case _QuickAction.mortality:
+        if (!ctx.hasBatch) return;
+        MortalityLoggingDialog.show(
+          context,
+          batchId: ctx.batch!.id,
+          pondId: ctx.pond!.id,
+        );
+        break;
+    }
+  }
+}
+
+enum _QuickAction { logFeed, waterTest, sampling, mortality }
+
+class _QuickActionsSheet extends StatelessWidget {
+  final ThemeData theme;
+  final AppSettingsState settings;
+  final _QuickActionContext actionCtx;
+  final ValueChanged<_QuickAction> onAction;
+
+  const _QuickActionsSheet({
+    required this.theme,
+    required this.settings,
+    required this.actionCtx,
+    required this.onAction,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final isDark = theme.brightness == Brightness.dark;
+
+    final headerSubtitle = actionCtx.hasBatch
+        ? '${actionCtx.pond!.name} · Batch #${actionCtx.batch!.batchNumber}'
+        : (actionCtx.hasPond
+              ? '${actionCtx.pond!.name} · ${settings.tr('qa_needs_batch')}'
+              : settings.tr('qa_needs_pond'));
+
+    final tiles = <Widget>[
+      _QuickActionTile(
+        icon: Icons.restaurant_rounded,
+        title: settings.tr('qa_log_feed'),
+        subtitle: settings.tr('qa_log_feed_sub'),
+        accent: AquaColors.primary,
+        enabled: actionCtx.hasBatch,
+        disabledHint: settings.tr('qa_needs_batch'),
+        onTap: () => onAction(_QuickAction.logFeed),
+      ),
+      _QuickActionTile(
+        icon: Icons.water_drop_rounded,
+        title: settings.tr('qa_water_test'),
+        subtitle: settings.tr('qa_water_test_sub'),
+        accent: const Color(0xFF0288D1),
+        enabled: actionCtx.hasPond,
+        disabledHint: settings.tr('qa_needs_pond'),
+        onTap: () => onAction(_QuickAction.waterTest),
+      ),
+      _QuickActionTile(
+        icon: Icons.scale_rounded,
+        title: settings.tr('qa_sampling'),
+        subtitle: settings.tr('qa_sampling_sub'),
+        accent: const Color(0xFF7B1FA2),
+        enabled: actionCtx.hasBatch,
+        disabledHint: settings.tr('qa_needs_batch'),
+        onTap: () => onAction(_QuickAction.sampling),
+      ),
+      _QuickActionTile(
+        icon: Icons.heart_broken_rounded,
+        title: settings.tr('qa_mortality'),
+        subtitle: settings.tr('qa_mortality_sub'),
+        accent: AquaColors.statusCritical,
+        enabled: actionCtx.hasBatch,
+        disabledHint: settings.tr('qa_needs_batch'),
+        onTap: () => onAction(_QuickAction.mortality),
+      ),
+    ];
+
+    return Container(
+      margin: const EdgeInsets.fromLTRB(12, 0, 12, 12),
+      padding: const EdgeInsets.fromLTRB(16, 12, 16, 20),
+      decoration: BoxDecoration(
+        color: theme.colorScheme.surfaceContainerLow,
+        borderRadius: BorderRadius.circular(24),
+        border: Border.all(
+          color: isDark ? const Color(0x1FFFFFFF) : const Color(0x14000000),
+        ),
+      ),
+      child: SafeArea(
+        top: false,
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Center(
+              child: Container(
+                width: 36,
+                height: 4,
+                margin: const EdgeInsets.only(bottom: 12),
+                decoration: BoxDecoration(
+                  color: theme.colorScheme.onSurfaceVariant.withOpacity(0.4),
+                  borderRadius: BorderRadius.circular(100),
+                ),
+              ),
+            ),
+            Row(
+              children: [
+                Container(
+                  padding: const EdgeInsets.all(8),
+                  decoration: BoxDecoration(
+                    gradient: const LinearGradient(
+                      colors: [Color(0xFF006876), Color(0xFF00A2B8)],
+                      begin: Alignment.topLeft,
+                      end: Alignment.bottomRight,
+                    ),
+                    borderRadius: BorderRadius.circular(12),
+                  ),
+                  child: const Icon(
+                    Icons.bolt_rounded,
+                    color: Colors.white,
+                    size: 20,
+                  ),
+                ),
+                const SizedBox(width: 10),
+                Expanded(
+                  child: Column(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      Text(
+                        settings.tr('quick_actions'),
+                        style: theme.textTheme.titleMedium?.copyWith(
+                          fontWeight: FontWeight.w700,
+                          letterSpacing: -0.2,
+                        ),
+                      ),
+                      Text(
+                        headerSubtitle,
+                        style: theme.textTheme.bodySmall?.copyWith(
+                          color: theme.colorScheme.onSurfaceVariant,
+                        ),
+                        overflow: TextOverflow.ellipsis,
+                      ),
+                    ],
+                  ),
+                ),
